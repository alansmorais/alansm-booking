{
  "name": "alansm-booking",
  "private": true,
  "scripts": {
    "test:rules": "node --test tests/firestore.rules.test.mjs",
    "test:functions:build": "npm --prefix functions run build",
    "test": "npm run test:rules && npm run test:functions:integration && npm run test:functions:build",
    "test:functions:integration": "node --test tests/functions.integration.test.mjs",
    "test:adapter": "node --test tests/data-adapter.test.mjs",
    "test:auth-adapter": "node --test tests/auth-adapter.test.mjs",
    "test:workspace-adapter": "node --test tests/workspace-adapter.test.mjs",
    "test:onboarding": "node --test tests/onboarding-flow.test.mjs",
    "test:firebase-adapters": "node --test tests/firebase-auth-adapter.test.mjs tests/firebase-workspace-adapter.test.mjs",
    "test:invitation": "node --test tests/invitation-flow.test.mjs",
    "test:invitation-page": "node --test tests/invitation-page.test.mjs",
    "test:team": "node --test tests/team.test.mjs",
    "test:firebase-emulator": "node --test tests/firebase-emulator.test.mjs",
    "test:all-adapters": "npm run test:adapter && npm run test:auth-adapter && npm run test:workspace-adapter && npm run test:onboarding && npm run test:invitation && npm run test:invitation-page && npm run test:firebase-adapters && npm run test:firebase-emulator && npm run test:team && npm run test:firebase-config",
    "test:firebase-config": "node --test tests/firebase-config-function.test.mjs"
  },
  "devDependencies": {
    "@firebase/rules-unit-testing": "^4.0.1",
    "firebase": "^11.0.0",
    "firebase-admin": "^13.0.0"
  }
}
