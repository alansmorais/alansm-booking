rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    function memberPath(tenantId) {
      return /databases/$(database)/documents/tenants/$(tenantId)/members/$(request.auth.uid);
    }

    function activeMember(tenantId) {
      return signedIn()
        && exists(memberPath(tenantId))
        && get(memberPath(tenantId)).data.status == 'active';
    }

    function hasRole(tenantId, roles) {
      return activeMember(tenantId)
        && get(memberPath(tenantId)).data.role in roles;
    }

    match /tenants/{tenantId} {
      allow get: if activeMember(tenantId);
      allow list, create, update, delete: if false;

      match /members/{userId} {
        allow get: if signedIn() && request.auth.uid == userId;
        allow list, create, update, delete: if false;
      }

      match /professionals/{professionalId} {
        allow read: if activeMember(tenantId);
        allow write: if false;
      }

      match /services/{serviceId} {
        allow read: if activeMember(tenantId);
        allow write: if false;
      }

      match /clients/{clientId} {
        // Client contact records are available only through role-checked server APIs.
        // Do not expose the full client collection to browser queries.
        allow read, write: if false;
      }

      match /appointments/{appointmentId} {
        // Agenda data is returned through bounded, sanitized callable Functions.
        // Direct reads could expose client identifiers, notes and contact metadata.
        allow read, write: if false;
      }

      match /blocks/{blockId} {
        allow read: if activeMember(tenantId);
        allow write: if false;
      }

      match /scheduleSettings/{settingId} {
        allow read: if activeMember(tenantId);
        allow write: if false;
      }

      match /auditLog/{eventId} {
        allow read: if hasRole(tenantId, ['owner', 'admin']);
        allow write: if false;
      }
    }

    // Public booking documents must contain only explicitly public fields.
    // Creation/update is reserved for trusted backend code.
    match /publicBookingPages/{slug} {
      allow get: if resource.data.published == true;
      allow list, create, update, delete: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}